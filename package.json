{
  "name": "@myvciso/veriniceveo-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript/JavaScript client for the verinice.veo REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "DISCLAIMER.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "verinice",
    "veo",
    "grc",
    "isms",
    "rest-client",
    "sdk"
  ],
  "author": "myvCISO",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myvciso/veriniceveo-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/myvciso/veriniceveo-sdk/issues"
  },
  "homepage": "https://github.com/myvciso/veriniceveo-sdk#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
